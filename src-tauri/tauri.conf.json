{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markcardstudio",
  "version": "0.1.2",
  "identifier": "markcard.woollypix.cn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "markcardstudio",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RUY4RjIzNjg0QUMyRjAKUldUd3drcG9JNC92eFdlMGMyN3NVeTVvcFZ0Vkh6ak5jL1NVVFpOaFRBZVBIVjZmYUt1MjZ1czYK",
      "endpoints": [
        "https://github.com/pangxiaobin/MarkCardStudio/releases/latest/download/latest.json"
      ]
    }
  }
}